# Choose one or more provider keys depending on what you use.
OPENAI_API_KEY=
AZURE_OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Comma-separated allowlist of frontend origins.
# Use exact origins, e.g. https://app.example.com,http://localhost:5500
# Use * only for local debugging.
ALLOWED_ORIGINS=http://localhost:5500

# Optional: backend port
PORT=8000

# Optional logging verbosity: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
